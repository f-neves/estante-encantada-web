# Estante Encantada Web · variáveis de ambiente
#
# Copie para `.env` e ajuste. Todas são lidas em tempo de build pelo Vite,
# então precisam do prefixo VITE_ e exigem reiniciar o `npm run dev`.

# Modo local (padrão): o site não fala com backend nenhum. Livros vêm de
# src/data/books.json, mídia de /uploads e o estado fica no navegador.
# Deixe em 1 para publicar como site estático.
VITE_OFFLINE=1

# Modo online: apague a linha acima (ou use VITE_OFFLINE=0) e aponte para a API.
# O site em HTTPS não consegue chamar uma API em HTTP, então em produção
# a URL precisa ser https.
VITE_API_URL=http://192.168.100.60:3000/api

# E-mail usado na identificação automática do modo online (rota /auth/dev do
# backend, que existe fora de produção). Use o e-mail de uma conta ADMIN para
# enxergar o painel de administração.
VITE_DEV_EMAIL=admin@estante.local
